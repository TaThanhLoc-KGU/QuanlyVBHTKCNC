# Copy thanh .env cung thu muc de docker-compose tu doc. KHONG commit file .env thuc.
DB_NAME=htkhcn
DB_USERNAME=htkhcn_app
DB_PASSWORD=doi_password_nay
JWT_SECRET=doi_chuoi_bi_mat_it_nhat_32_ky_tu_o_day
# Tai khoan Admin duoc DataSeeder tao san o lan chay dau tien (bat buoc doi
# mat khau khi dang nhap lan dau) - doi ADMIN_DEFAULT_PASSWORD o day truoc
# khi len production thay vi dung mac dinh.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@dhkg.edu.vn
ADMIN_DEFAULT_PASSWORD=doi_mat_khau_nay
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tai_khoan_gmail@gmail.com
MAIL_PASSWORD=app_password_gmail
MAIL_ENABLED=false
# Cong tren HOST (chi 127.0.0.1) de nginx goc cua aaPanel reverse-proxy toi khi
# tao "Website" cho domain nay - xem docker-compose.yml. Doi neu 5280 da bi
# chiem tren server.
FRONTEND_PORT=5280
# Voi kien truc frontend (Nginx) reverse-proxy /api/... sang backend cung
# docker network (xem docker-compose.yml), trinh duyet goi API cung origin
# voi trang web nen CORS it quan trong - van nen dat dung domain that su
# dung de phong khi co client khac goi thang API.
APP_CORS_ORIGINS=https://htkhcn.vnkgu.edu.vn
# API "Van ban noi bo don vi" cua he thong CongVan truong (chi doc, dong bo
# 1 chieu vao module Van ban DHKG) - xin key tai Admin CongVan > Quan tri he
# thong > API Key don vi (chon P.HTKHCN). Bo trong = tat tinh nang dong bo.
CONGVAN_BASE_URL=https://qlvb.vnkgu.edu.vn/api/v1/vanbannoibo
# API "Cong van den theo don vi" (thu tu don vi khac gui den, doc, dong bo 1
# chieu vao module rieng "Cong van den") - dung CHUNG CONGVAN_API_KEY o tren.
CONGVAN_DEN_BASE_URL=https://qlvb.vnkgu.edu.vn/api/v1/vanban-den
CONGVAN_API_KEY=
